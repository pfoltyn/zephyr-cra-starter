// GENERATED by scripts/hwsync.py from hardware.yaml. Do not edit; run `west hwsync generate`.
// Twin of Twin Sensor Node rev A.

using "platforms/cpus/nrf52840.repl"

flash:
    init:
        FillWithRepeatingData [0xFF]

env: I2C.BME280 @ twi0 0x76
accel: Sensors.LIS2DW12 @ twi0 0x19

gpio0:
    13 -> led_status@0

led_status: Miscellaneous.LED @ gpio0 13
    invert: true

button_user: Miscellaneous.Button @ gpio0 11
    invert: true
    -> gpio0@11

// NOT SIMULATED (shown in docs/hardware/pinout.md):
//   accel.int1: signal not wired in the twin (model has no output for it)
